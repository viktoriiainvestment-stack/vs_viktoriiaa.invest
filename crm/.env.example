# Скопіюйте у .env (не в git) і заповніть реальними значеннями.

# Токен CRM-бота Telegram — окремий від бота контент-плану (bot.py),
# отримати у @BotFather (/newbot).
TELEGRAM_CRM_BOT_TOKEN=

# Ваш особистий chat_id у Telegram — сюди прийдуть сповіщення про нові ліди
# й щоденні завдання. Напишіть CRM-боту /id, щоб дізнатись його.
ADMIN_TELEGRAM_CHAT_ID=

# Будь-який довгий випадковий рядок — секрет для входу в дашборд.
ADMIN_TOKEN=

# Будь-який довгий випадковий рядок — секрет для /api/webhook/lead
# (приймає ліди з Zapier/Make/вашого квіз-бота, див. README).
LEAD_WEBHOOK_TOKEN=

# Порт, на якому слухає веб-сервер (хостинг зазвичай підставляє сам).
PORT=5000

# Увімкнути щоденний дайджест завдань о DIGEST_HOUR (година сервера, 0-23).
ENABLE_DAILY_DIGEST=false
DIGEST_HOUR=9
