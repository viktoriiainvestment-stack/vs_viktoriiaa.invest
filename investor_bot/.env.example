# Скопіюйте у .env (не в git) і заповніть реальними значеннями.

# Токен бота-аналітика в Telegram — окремий від bot.py (контент-план) і
# crm/telegram_bot.py (ліди). Отримати у @BotFather (/newbot).
TELEGRAM_INVESTOR_BOT_TOKEN=

# Ключ Anthropic для аналізу — той самий, що й у bot.py, якщо вже є.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Google Drive: JSON-ключ сервісного акаунта (весь файл одним рядком) і
# ID папки на вашому Диску, яку ви розшарили на email цього акаунта з
# правами редактора. Без цих двох змінних бот працюватиме, просто не
# копіюватиме файли на Диск. Детальніше — investor_bot/README.md.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_PARENT_FOLDER_ID=
GOOGLE_DRIVE_MARKET_FOLDER_NAME=Ринок
